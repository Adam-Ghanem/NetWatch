# Copy this file to .env, or run: python scripts/start.py
NETWATCH_API_KEY=replace-with-a-long-random-secret

# Separate server-only key for tamper-evident audit records. The launcher creates it.
# In production, inject it from managed secret storage and back it up separately.
NETWATCH_AUDIT_HMAC_KEY=replace-with-an-independent-audit-hmac-key

# Optional server-side intelligence provider. Never expose this value in browser code,
# logs, reports, screenshots, Docker images, or Git history.
OPENAI_API_KEY=
# Generated automatically by scripts/start.py. These values must remain server-side,
# independent from OPENAI_API_KEY, and absent from browser code and logs.
NETWATCH_AI_SAFETY_SECRET=replace-with-an-independent-random-secret
NETWATCH_AI_SUBJECT_ID=replace-with-an-opaque-random-subject
NETWATCH_AI_ENABLED=true
NETWATCH_AI_MODEL=gpt-5.6-luna
NETWATCH_AI_TIMEOUT_SECONDS=25
NETWATCH_AI_MAX_OUTPUT_TOKENS=1200
NETWATCH_AI_MAX_CONCURRENT_REQUESTS=2
NETWATCH_AI_RATE_LIMIT_REQUESTS=5
NETWATCH_AI_RATE_LIMIT_WINDOW_SECONDS=600
NETWATCH_AI_DAILY_REQUEST_LIMIT=50
NETWATCH_AI_CACHE_TTL_SECONDS=900

# Optional company roles. Leave blank to disable that role.
# Each configured key must be a different random secret with at least 32 characters.
NETWATCH_OPERATOR_KEY=
NETWATCH_VIEWER_KEY=

# Optional enterprise SSO. Put NetWatch behind an OIDC-aware reverse proxy that
# forwards the signed bearer token. All URLs must use HTTPS and every user must
# belong to one of the exact mapped groups. Shared role keys remain available as
# local break-glass credentials when configured.
NETWATCH_OIDC_ENABLED=false
NETWATCH_OIDC_ISSUER=
NETWATCH_OIDC_AUDIENCE=
NETWATCH_OIDC_JWKS_URL=
NETWATCH_OIDC_GROUPS_CLAIM=groups
NETWATCH_OIDC_ADMIN_GROUPS=
NETWATCH_OIDC_OPERATOR_GROUPS=
NETWATCH_OIDC_VIEWER_GROUPS=
NETWATCH_OIDC_ALGORITHMS=RS256
NETWATCH_OIDC_CLOCK_SKEW_SECONDS=30
NETWATCH_OIDC_MAX_TOKEN_AGE_SECONDS=3600
NETWATCH_OIDC_JWKS_CACHE_SECONDS=300
NETWATCH_OIDC_JWKS_TIMEOUT_SECONDS=5

# Browser origins allowed to call the local API.
NETWATCH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# HTTP Host headers accepted by the local API. Wildcard values are ignored.
NETWATCH_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep interactive API documentation disabled unless you need it locally.
NETWATCH_API_DOCS=false

# Conservative local defaults.
NETWATCH_MAX_CONCURRENT_SCANS=1
NETWATCH_RATE_LIMIT_REQUESTS=30
NETWATCH_RATE_LIMIT_WINDOW_SECONDS=60
NETWATCH_PORT_SCAN_WORKERS=12

# Scheduled scans are opt-in. Policies still require Admin approval in the dashboard.
NETWATCH_SCHEDULER_ENABLED=false
NETWATCH_SCHEDULER_POLL_SECONDS=30
