# Copy this file to .env, or run: python scripts/start.py
NETWATCH_API_KEY=replace-with-a-long-random-secret

# Browser origins allowed to call the local API.
NETWATCH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Keep interactive API documentation disabled unless you need it locally.
NETWATCH_API_DOCS=false

# Conservative local defaults.
NETWATCH_MAX_CONCURRENT_SCANS=1
NETWATCH_RATE_LIMIT_REQUESTS=30
NETWATCH_RATE_LIMIT_WINDOW_SECONDS=60
NETWATCH_PORT_SCAN_WORKERS=12
