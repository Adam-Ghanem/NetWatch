{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netwatch.local/schemas/netwatch-service-v1.schema.json",
  "title": "NetWatch Service Evidence v1",
  "description": "One normalized metadata-only service observation. Packet payload content is never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_source",
    "payload_retained",
    "scan_run_id",
    "observed_at",
    "ip_address",
    "address_family",
    "port",
    "protocol",
    "service",
    "service_detection",
    "service_product",
    "service_version",
    "service_confidence",
    "status",
    "risk",
    "response_time_ms"
  ],
  "properties": {
    "schema_version": {"const": "netwatch.service.v1"},
    "evidence_source": {"const": "netwatch.service_observation"},
    "payload_retained": {"const": false},
    "scan_run_id": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "maxLength": 64},
    "ip_address": {"type": "string", "maxLength": 45},
    "address_family": {"enum": ["ipv4", "ipv6"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "protocol": {"type": "string", "maxLength": 16},
    "service": {"type": "string", "maxLength": 128},
    "service_detection": {"type": "string", "maxLength": 256},
    "service_product": {"type": "string", "maxLength": 256},
    "service_version": {"type": "string", "maxLength": 256},
    "service_confidence": {"type": "string", "maxLength": 32},
    "status": {"type": "string", "maxLength": 64},
    "risk": {"type": "string", "maxLength": 64},
    "response_time_ms": {"type": ["number", "null"], "minimum": 0}
  }
}
