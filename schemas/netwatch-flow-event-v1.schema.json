{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netwatch.local/schemas/netwatch-flow-event-v1.schema.json",
  "title": "NetWatch Flow Event v1",
  "description": "One metadata-only NDJSON flow event. Packet payload content is never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type", "payload_retained", "schema_version", "evidence_source", "flow_id",
    "community_id", "address_family", "protocol", "service", "tcp_state", "endpoint_a",
    "endpoint_b", "originator", "responder", "packets", "bytes", "a_to_b_packets",
    "a_to_b_bytes", "b_to_a_packets", "b_to_a_bytes", "originator_packets",
    "originator_bytes", "responder_packets", "responder_bytes", "first_seen", "last_seen",
    "duration_ms"
  ],
  "properties": {
    "event_type": {"const": "flow"},
    "payload_retained": {"const": false},
    "schema_version": {"const": "netwatch.flow.v1"},
    "evidence_source": {"const": "netwatch.flow_analysis"},
    "flow_id": {"type": ["string", "null"]},
    "community_id": {"type": ["string", "null"]},
    "address_family": {"enum": ["", "ipv4", "ipv6"]},
    "protocol": {"type": ["string", "null"]},
    "service": {"type": ["string", "null"]},
    "tcp_state": {"type": ["string", "null"]},
    "endpoint_a": {"$ref": "#/$defs/endpoint"},
    "endpoint_b": {"$ref": "#/$defs/endpoint"},
    "originator": {"$ref": "#/$defs/endpoint"},
    "responder": {"$ref": "#/$defs/endpoint"},
    "packets": {"type": ["integer", "null"], "minimum": 0},
    "bytes": {"type": ["integer", "null"], "minimum": 0},
    "a_to_b_packets": {"type": ["integer", "null"], "minimum": 0},
    "a_to_b_bytes": {"type": ["integer", "null"], "minimum": 0},
    "b_to_a_packets": {"type": ["integer", "null"], "minimum": 0},
    "b_to_a_bytes": {"type": ["integer", "null"], "minimum": 0},
    "originator_packets": {"type": ["integer", "null"], "minimum": 0},
    "originator_bytes": {"type": ["integer", "null"], "minimum": 0},
    "responder_packets": {"type": ["integer", "null"], "minimum": 0},
    "responder_bytes": {"type": ["integer", "null"], "minimum": 0},
    "first_seen": {"type": ["string", "null"]},
    "last_seen": {"type": ["string", "null"]},
    "duration_ms": {"type": ["integer", "number", "null"], "minimum": 0}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "port"],
      "properties": {
        "ip": {"type": "string", "maxLength": 45},
        "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}
      }
    }
  }
}
